{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft 365 Copilot (Microsoft Graph) Connectors External Items API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "External Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create or update an external item",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://graph.microsoft.com/v1.0/external/connections/:connection-id/items/:item-id",
            "params": [
              {
                "name": "connection-id",
                "value": "",
                "type": "path"
              },
              {
                "name": "item-id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update an external item"
        },
        {
          "info": {
            "name": "Delete an external item",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://graph.microsoft.com/v1.0/external/connections/:connection-id/items/:item-id",
            "params": [
              {
                "name": "connection-id",
                "value": "",
                "type": "path"
              },
              {
                "name": "item-id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an external item"
        }
      ]
    }
  ],
  "bundled": true
}